{
  "name": "kenmark-skills",
  "version": "2.3.24",
  "description": "43 universal Kenmark agent skills + 12-command CLI for Cursor, Claude Code, Codex, and other SKILL.md-compatible agents. Includes setup, init, update, adopt, cleanup, validate, doctor, inventory, mcp, selectable optional packs with repo-aware suggestions, kenmark-repo-* maintenance skills, kenmark-security-review, kenmark-performance, and kenmark-test-* testing suite skills.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "bin": {
    "kenmark-skills": "scripts/cli.js",
    "kenmark-skills-setup": "scripts/setup-skills.js"
  },
  "scripts": {
    "init": "node scripts/cli.js init",
    "setup": "node scripts/cli.js setup",
    "update": "node scripts/cli.js update",
    "adopt": "node scripts/cli.js adopt",
    "uninstall": "node scripts/cli.js uninstall",
    "uninstall:skills": "node scripts/cli.js uninstall",
    "mcp:uninstall": "node scripts/cli.js mcp uninstall",
    "inventory": "node scripts/cli.js inventory",
    "subagents-inventory": "node scripts/cli.js subagents-inventory",
    "install-recommended": "node scripts/cli.js install-recommended",
    "cleanup": "node scripts/cli.js cleanup",
    "doctor": "node scripts/cli.js doctor",
    "doctor:local": "node scripts/cli.js doctor",
    "check": "node scripts/cli.js doctor",
    "validate": "node scripts/validate-repo.js",
    "test": "npm run validate && npm run test:cli && npm run test:packs-verify",
    "test:cli": "node scripts/test-cli-smoke.js && node scripts/test-interactive-scope-prompt.js && node scripts/test-interactive-noninteractive-stdin.js && node scripts/test-cli-package.js && node scripts/test-gemini-codex-dedupe.js && node scripts/test-antigravity-dedupe.js",
    "test:packs-verify": "node scripts/test-packs-verify-skip.js",
    "test:install": "node scripts/test-install-temp-home.js",
    "test:pack": "node scripts/test-pack.js",
    "test:broken-links": "node scripts/test-broken-symlink-cleanup.js && node scripts/test-cleanup-temp-home.js && node scripts/test-legacy-cleanup-canonical.js",
    "test:portability": "node scripts/test-skill-portability.js",
    "test:all": "npm run test && npm run test:install && npm run test:pack && npm run test:broken-links && npm run test:portability",
    "prepublishOnly": "npm run test:all && npm run pack:check",
    "setup:skills": "node scripts/setup-skills.js",
    "pack:check": "npm pack --dry-run",
    "publish:public": "npm publish --access public"
  },
  "files": [
    "CHANGELOG.md",
    "skills/README.md",
    "skills/user-skills/**/*",
    "skills/user-skills/recommended-catalog.json",
    "config/mcp-servers.json",
    "config/mcp-profiles.json",
    "scripts/cli.js",
    "scripts/cli-package.js",
    "scripts/interactive.js",
    "scripts/kenmark-hub.js",
    "scripts/recommended-catalog.js",
    "scripts/setup-skills.js",
    "scripts/skills-adopt.js",
    "scripts/doctor.js",
    "scripts/kenmark-cleanup.js",
    "scripts/validate.js",
    "scripts/validate-repo.js",
    "scripts/kenmark-setup.js",
    "scripts/skills-inventory.js",
    "scripts/kenmark-packs.js",
    "scripts/kenmark-update.js",
    "scripts/subagents-inventory.js",
    "scripts/test-cli-smoke.js",
    "scripts/test-cli-package.js",
    "scripts/test-interactive-scope-prompt.js",
    "scripts/test-interactive-noninteractive-stdin.js",
    "scripts/test-gemini-codex-dedupe.js",
    "scripts/test-antigravity-dedupe.js",
    "scripts/test-packs-verify-skip.js",
    "scripts/test-install-temp-home.js",
    "scripts/test-pack.js",
    "scripts/test-broken-symlink-cleanup.js",
    "scripts/test-cleanup-temp-home.js",
    "scripts/test-legacy-cleanup-canonical.js",
    "scripts/test-skill-portability.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Kenmark ITan Solutions",
  "contributors": [
    "Tanooj Mehra",
    "Adwait Date"
  ],
  "keywords": [
    "kenmark",
    "cursor",
    "codex",
    "claude-code",
    "skills",
    "subagents",
    "ai-agent",
    "workflow",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanoojmehra/kenmark-skills.git"
  },
  "bugs": {
    "url": "https://github.com/tanoojmehra/kenmark-skills/issues"
  },
  "homepage": "https://github.com/tanoojmehra/kenmark-skills#readme"
}
