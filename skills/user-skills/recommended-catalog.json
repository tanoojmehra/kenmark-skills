{
  "version": 5,
  "mode": "selectable",
  "updatedAt": "2026-06-03",
  "notes": "Selectable optional third-party installs with repo-aware suggestions. Presets are power-user/CI shortcuts only.",
  "defaults": {
    "scope": "global",
    "selectedIds": ["impeccable", "code-review-skill"]
  },
  "installRules": {
    "guidance": "Do not install multiple overlapping packs for the same purpose unless the user explicitly asks.",
    "overlapCaps": [
      { "category": "design", "maxPrimary": 1, "note": "One primary UI/design pack (e.g. Impeccable)" },
      { "category": "review", "maxPrimary": 1, "note": "One primary code-review pack" },
      { "category": "seo", "maxPrimary": 1, "note": "Prefer selected SEO skills; full pack only on request" },
      { "category": "harness", "maxPrimary": 1, "note": "ECC minimal by default; avoid stacking with plugin install" },
      { "category": "navigation", "maxPrimary": 1, "note": "Graphify for medium/large repos only" }
    ]
  },
  "presets": [
    {
      "id": "lean",
      "name": "Lean Daily Coding",
      "description": "Impeccable + code review — same as default selection.",
      "packIds": ["impeccable", "code-review-skill"]
    },
    {
      "id": "core-next-lite",
      "name": "Core Next.js Lite",
      "description": "Next.js essentials without Graphify or ECC.",
      "packIds": ["impeccable", "code-review-skill"]
    },
    {
      "id": "core-next",
      "name": "Core Next.js Full-Stack",
      "description": "core-next-lite + Graphify for medium/large Next.js repos.",
      "extends": "core-next-lite",
      "packIds": ["graphify"]
    },
    {
      "id": "core-next-agentic",
      "name": "Core Next.js Agentic",
      "description": "core-next plus ECC minimal (manual install).",
      "extends": "core-next",
      "packIds": [{ "id": "ecc", "profile": "minimal" }]
    },
    {
      "id": "growth-seo",
      "name": "Growth + SEO/GEO",
      "description": "core-next + selected SEO/GEO skills (not the full 20-skill suite).",
      "extends": "core-next",
      "packIds": [{ "id": "seo-geo-selected" }]
    },
    {
      "id": "audit-review",
      "name": "Audit / Review",
      "description": "Code review + Graphify without default UI design skills.",
      "packIds": ["code-review-skill", "graphify"]
    },
    {
      "id": "experimental-heavy",
      "name": "Experimental Heavy",
      "description": "Large experimental install — high bloat, explicit opt-in only.",
      "risk": "high-bloat",
      "requiresConfirmation": true,
      "packIds": [
        "impeccable",
        "code-review-skill",
        "graphify",
        { "id": "ecc", "profile": "core" },
        "seo-geo-full"
      ]
    }
  ],
  "packs": [
    {
      "id": "impeccable",
      "name": "Impeccable",
      "category": "design",
      "weight": "light",
      "bloatScore": 1,
      "recommended": true,
      "defaultSelected": true,
      "helpsWith": ["UI polish", "design systems", "frontend taste"],
      "bestFor": ["UI polish", "frontend taste", "design systems"],
      "avoidWhen": ["backend-only scripts", "non-UI refactors"],
      "suggestiveTest": {
        "question": "Does this project have a user-facing UI?",
        "signals": ["next.config", "ui-app-router", "ui-src-components", "ui-pages-dir", "tailwind.config", "shadcn-ui", "css-modules"],
        "recommendWhen": "any",
        "recommendation": "recommended"
      },
      "url": "https://github.com/pbakaus/impeccable",
      "description": "Design language for agent harnesses — UI/UX quality, anti-slop patterns, frontend polish workflows.",
      "warning": "The upstream skills CLI may report partial failures for unsupported harnesses (e.g. PromptScript). If Verify is OK, Impeccable is installed for supported agents.",
      "install": {
        "global": {
          "command": "npx --yes skills add pbakaus/impeccable -g -y",
          "summary": "User-wide skill (Claude/Cursor agents paths via skills CLI)"
        },
        "project": {
          "command": "npx --yes impeccable skills install",
          "cwd": "project",
          "summary": "Project-local install from current directory"
        },
        "alternatives": [
          "Claude plugin: /plugin marketplace add pbakaus/impeccable"
        ],
        "verify": {
          "global": "test -f \"$HOME/.agents/skills/impeccable/SKILL.md\" || test -L \"$HOME/.claude/skills/impeccable\"",
          "project": "test -f \".agents/skills/impeccable/SKILL.md\" || test -L \".claude/skills/impeccable\""
        }
      }
    },
    {
      "id": "code-review-skill",
      "name": "Awesome Code Review",
      "category": "review",
      "weight": "light",
      "bloatScore": 1,
      "recommended": true,
      "defaultSelected": true,
      "helpsWith": ["PR review", "correctness", "multi-language review"],
      "bestFor": ["PR review", "correctness", "multi-language codebases"],
      "avoidWhen": [],
      "suggestiveTest": {
        "question": "Will agents review or refactor code in this repo?",
        "signals": ["git-repo", "typescript-project", "multi-language-src"],
        "recommendWhen": "any",
        "recommendation": "recommended"
      },
      "url": "https://github.com/awesome-skills/code-review-skill",
      "description": "Modular code-review skill for Claude Code — 19+ languages/frameworks loaded progressively with a four-phase review process.",
      "warning": "Git-based install (not npx). Re-runs clone once, then `git pull --ff-only`.",
      "installStrategy": "git-sync",
      "install": {
        "repoUrl": "https://github.com/awesome-skills/code-review-skill.git",
        "global": {
          "target": "$HOME/.claude/skills/code-review-skill",
          "summary": "Sync the repo into the user's global Claude skills directory"
        },
        "project": {
          "target": ".claude/skills/code-review-skill",
          "cwd": "project",
          "summary": "Sync the repo into the current project's .claude/skills/ directory"
        },
        "alternatives": [
          "Windows (PowerShell): git clone https://github.com/awesome-skills/code-review-skill.git \"$env:USERPROFILE\\.claude\\skills\\code-review-skill\""
        ],
        "verify": {
          "global": "test -f \"$HOME/.claude/skills/code-review-skill/SKILL.md\"",
          "project": "test -f \".claude/skills/code-review-skill/SKILL.md\""
        }
      }
    },
    {
      "id": "graphify",
      "name": "Graphify",
      "category": "navigation",
      "weight": "medium",
      "bloatScore": 2,
      "recommended": false,
      "defaultSelected": false,
      "helpsWith": ["large-repo navigation", "architecture maps", "cross-file reasoning"],
      "bestFor": ["large repos", "architecture understanding", "full-stack navigation"],
      "avoidWhen": ["small repos", "simple one-file edits"],
      "suggestiveTest": {
        "question": "Is this repo large enough to benefit from a knowledge graph?",
        "signals": ["repo-file-count-high", "monorepo-workspace", "next.config"],
        "recommendWhen": ">=2",
        "recommendation": "optional"
      },
      "url": "https://github.com/safishamsi/graphify",
      "description": "Turns code, schemas, docs, and media into a queryable knowledge graph for project navigation.",
      "warning": "Python-based (graphifyy on PyPI). Requires uv, pipx, or pip.",
      "install": {
        "global": {
          "command": "uv tool install graphifyy && graphify install",
          "summary": "Install graphifyy via uv, then register the skill with global agents"
        },
        "project": {
          "command": "uv tool install graphifyy && graphify install --project",
          "cwd": "project",
          "summary": "Install the package globally, then register into the current project"
        },
        "alternatives": [
          "pipx install graphifyy && graphify install"
        ],
        "verify": {
          "global": "test -f \"$HOME/.claude/skills/graphify/SKILL.md\" || test -f \"$HOME/.agents/skills/graphify/SKILL.md\"",
          "project": "test -f \".claude/skills/graphify/SKILL.md\" || test -f \".agents/skills/graphify/SKILL.md\""
        }
      }
    },
    {
      "id": "seo-geo-selected",
      "aliases": ["seo-geo-claude-skills"],
      "name": "SEO & GEO (selected skills)",
      "category": "seo",
      "weight": "medium",
      "bloatScore": 2,
      "selectedBloatScore": 2,
      "recommended": false,
      "defaultSelected": false,
      "seoMode": "selected-skills",
      "defaultSeoSkills": [
        "keyword-research",
        "technical-seo-checker",
        "schema-markup-generator",
        "on-page-seo-auditor",
        "seo-content-writer",
        "geo-content-optimizer"
      ],
      "helpsWith": ["public websites", "content marketing", "GEO optimization"],
      "bestFor": ["client websites", "landing pages", "SEO-heavy marketing sites"],
      "avoidWhen": ["private apps", "admin dashboards", "non-public tools"],
      "suggestiveTest": {
        "question": "Is this a public marketing or content site?",
        "signals": ["seo-marketing-deps", "public-static-site", "sitemap-or-robots"],
        "recommendWhen": ">=1",
        "recommendation": "optional"
      },
      "url": "https://github.com/aaron-he-zhu/seo-geo-claude-skills",
      "description": "Six high-value SEO/GEO skills (keyword research, technical audit, schema, on-page, content, GEO) — not the full 20-skill suite.",
      "warning": "Installs selected skills only. For all 20 skills use seo-geo-full.",
      "install": {
        "global": {
          "command": "npx --yes skills add aaron-he-zhu/seo-geo-claude-skills -g -y",
          "summary": "Full pack command (use batch selected-skills install at runtime)"
        },
        "project": {
          "command": "npx --yes skills add aaron-he-zhu/seo-geo-claude-skills -y",
          "cwd": "project",
          "summary": "Full pack command (use batch selected-skills install at runtime)"
        },
        "skillInstall": {
          "global": {
            "command": "npx --yes skills add aaron-he-zhu/seo-geo-claude-skills -g -y -s {{skill}}",
            "summary": "Install one SEO/GEO skill globally"
          },
          "project": {
            "command": "npx --yes skills add aaron-he-zhu/seo-geo-claude-skills -y -s {{skill}}",
            "cwd": "project",
            "summary": "Install one SEO/GEO skill into the current project"
          }
        },
        "batchSkillInstall": {
          "global": {
            "command": "npx --yes skills add aaron-he-zhu/seo-geo-claude-skills -g -y -s {{skills}}",
            "summary": "Install selected SEO/GEO skills globally in one run"
          },
          "project": {
            "command": "npx --yes skills add aaron-he-zhu/seo-geo-claude-skills -y -s {{skills}}",
            "cwd": "project",
            "summary": "Install selected SEO/GEO skills into the current project in one run"
          }
        },
        "alternatives": [
          "Claude plugin: /plugin marketplace add aaron-he-zhu/seo-geo-claude-skills"
        ],
        "verify": {
          "global": "test -f \"$HOME/.agents/skills/keyword-research/SKILL.md\" || test -f \"$HOME/.claude/skills/keyword-research/SKILL.md\"",
          "project": "test -f \".agents/skills/keyword-research/SKILL.md\" || test -f \".claude/skills/keyword-research/SKILL.md\""
        }
      }
    },
    {
      "id": "seo-geo-full",
      "name": "SEO & GEO (full pack)",
      "category": "seo",
      "weight": "heavy",
      "bloatScore": 5,
      "recommended": false,
